# Copy this file to .env and fill in your own values.
# Add .env to .gitignore before you put a real key in it.
# Placeholder values only in this file. It is committed; .env is not.

# --- Model access -------------------------------------------------------------
# Primary provider. Free tier is sufficient for this project.
OPENROUTER_API_KEY=your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=meta-llama/llama-3.1-8b-instruct

# Fallback provider, used automatically when the primary fails or times out.
# Leave blank to disable the fallback; the system then degrades to escalation.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_MODEL_NAME=llama-3.1-8b-instant

# Set false to run the whole pipeline with no provider at all: retrieval and the
# deterministic rules still run, every ticket needing generation is escalated.
# Lets the harness complete unattended when no key is available.
ENABLE_LLM=true

# --- Embeddings and vector store ---------------------------------------------
# onnx (default, no torch) or sentence-transformers (requires requirements-optional.txt)
EMBEDDING_BACKEND=onnx
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
CHROMA_COLLECTION=cloudserve_docs
# Selected by scripts/tune_chunking.py over 300 development tickets.
# See docs/retrieval_experiment.md for the grid and the reasoning.
CHUNK_SIZE=400
CHUNK_OVERLAP=60
RETRIEVAL_TOP_K=5
# Cosine distance above which a passage is discarded. Tickets with no relevant
# documentation must be allowed to retrieve nothing rather than be given filler.
RETRIEVAL_MAX_DISTANCE=0.55
# dense is the measured production default; hybrid adds lexical overlap and RRF.
RETRIEVAL_STRATEGY=dense
RETRIEVAL_CANDIDATE_MULTIPLIER=3
RETRIEVAL_RRF_K=60

# --- Decision log -------------------------------------------------------------
DATABASE_URL=sqlite:///./storage/decisions.db

# --- Routing ------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.80
# Apply evaluation/calibration.json, produced by scripts/install_calibration.py
USE_CALIBRATION=true
# Comma-separated domains permitted in generated replies. Empty blocks all URLs.
ALLOWED_RESPONSE_DOMAINS=

# --- Runtime behaviour --------------------------------------------------------
LOG_LEVEL=INFO
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
TICKET_TIMEOUT_SECONDS=90
MAX_CONCURRENCY=4
RANDOM_SEED=42

# --- Data paths ---------------------------------------------------------------
DOCS_PATH=./data/documentation.json

# --- Service and monitoring ---------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
METRICS_PORT=8001
# Flip to true to stop all automatic responses; every ticket escalates to a human.
KILL_SWITCH=false
